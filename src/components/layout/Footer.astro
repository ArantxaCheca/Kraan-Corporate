---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <img src="/images/logo%20kraan%20corporate.png" alt="Kraan Corporate" class="footer__logo" width="230" height="52">
        <p class="footer__tagline">Boutique financiera especializada en M&A, Corporate Finance y Asset Management</p>
      </div>

      <nav class="footer__nav" aria-label="Enlaces del footer">
        <div class="footer__nav-col">
          <h3 class="footer__nav-title">Servicios</h3>
          <ul class="footer__nav-list">
            <li><a href="/servicios">M&A</a></li>
            <li><a href="/servicios">Corporate Finance</a></li>
            <li><a href="/servicios">Asset Management</a></li>
            <li><a href="/servicios">Valuación</a></li>
          </ul>
        </div>
        <div class="footer__nav-col">
          <h3 class="footer__nav-title">Compañía</h3>
          <ul class="footer__nav-list">
            <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
            <li><a href="/proceso">Proceso</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {currentYear} Kraan Corporate. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #D1D5DB;
    color: var(--color-text);
    padding: var(--space-16) 0 var(--space-8);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(107, 114, 128, 0.2);
  }

  .footer__logo {
    display: block;
    max-height: 52px;
    width: auto;
    margin-bottom: var(--space-4);
  }

  .footer__tagline {
    font-size: 0.9375rem;
    line-height: var(--line-height-relaxed);
    color: var(--color-muted);
    max-width: 360px;
  }

  .footer__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
  }

  .footer__nav-title {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .footer__nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__nav-list a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--transition-fast);
  }

  .footer__nav-list a:hover {
    color: var(--color-primary);
  }

  .footer__bottom {
    padding-top: var(--space-8);
    text-align: center;
  }

  .footer__copyright {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .footer {
      padding: var(--space-12) 0 var(--space-6);
    }

    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .footer__nav {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .footer__tagline {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .footer__nav {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
